# Copy to .env for local use. On Vercel, add these under Settings > Environment Variables.

# Any long random string. Signs the login cookie. Required when hosted.
SESSION_SECRET=

# Database (Turso, free): https://turso.tech -> create a database -> copy the URL and a token.
# Leave both empty locally and the app uses a file at data/susu.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
